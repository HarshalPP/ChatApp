{
  "info": {
    "name": "Chat Backend",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run the folders in order (or use Run collection). IDs are saved automatically into collection variables."
  },
  "item": [
    {
      "name": "0. Setup - Users",
      "item": [
        {
          "name": "Create user A",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/user",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "user"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Aman\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('userAId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create user B",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/user",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "user"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Priya\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('userBId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create user C",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/user",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "user"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Rahul\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('userCId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get user A",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/user/{{userAId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "user",
                "{{userAId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.expect(pm.response.code).to.be.oneOf([200]));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1. Required APIs",
      "item": [
        {
          "name": "1. Create chat",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/chat/create",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "chat",
                "create"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userAId\": \"{{userAId}}\",\n  \"userBId\": \"{{userBId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200/201', () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));",
                  "pm.collectionVariables.set('chatId', pm.response.json().chatId);"
                ]
              }
            }
          ]
        },
        {
          "name": "2. Send message",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/chat/{{chatId}}/message/send",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "chat",
                "{{chatId}}",
                "message",
                "send"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"senderId\": \"{{userAId}}\",\n  \"text\": \"Hello Priya!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('messageId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "2b. Send reply",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/chat/{{chatId}}/message/send",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "chat",
                "{{chatId}}",
                "message",
                "send"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"senderId\": \"{{userBId}}\",\n  \"text\": \"Hi Aman!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('replyId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "3. Get messages",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/chat/{{chatId}}/messages?limit=50",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "chat",
                "{{chatId}}",
                "messages"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "50"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.expect(pm.response.code).to.be.oneOf([200]));",
                  "pm.test('Oldest first', () => { const m = pm.response.json().messages; pm.expect(m[0].text).to.eql('Hello Priya!'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "4. Mark message read",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/chat/{{chatId}}/message/{{messageId}}/read",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "chat",
                "{{chatId}}",
                "message",
                "{{messageId}}",
                "read"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{userBId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.expect(pm.response.code).to.be.oneOf([200]));"
                ]
              }
            }
          ]
        },
        {
          "name": "5. Update last seen",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/chat/{{chatId}}/lastseen",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "chat",
                "{{chatId}}",
                "lastseen"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{userBId}}\",\n  \"messageId\": \"{{replyId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.expect(pm.response.code).to.be.oneOf([200]));"
                ]
              }
            }
          ]
        },
        {
          "name": "6. User chats",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/user/{{userAId}}/chats",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "user",
                "{{userAId}}",
                "chats"
              ]
            }
          },
          "event": [
